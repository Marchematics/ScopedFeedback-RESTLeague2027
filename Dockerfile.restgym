# Build with RESTgym's repository root as context, tool stored at tools/scoped-feedback-cpu.
FROM python:3.12-slim
WORKDIR /tool
COPY tools/scoped-feedback-cpu/requirements.txt /tool/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY tools/scoped-feedback-cpu/restleague /tool/restleague
COPY apis/*/specifications/* /specifications/
RUN mkdir -p /output
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-m", "restleague.entrypoint"]
